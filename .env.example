DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
GROQ_API_KEY="replace-with-your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-20b"
JWT_SECRET="replace-with-at-least-32-random-characters"

